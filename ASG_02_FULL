import numpy as np

# >>> TASK 1A File Reading and Error Handling <<<<

FILE = "kedai_runcit_sales.csv"

def validate_row(fields):

    # Check whether the row has 4 fields
    if len(fields) < 4:
        return None, f"Missing field ({len(fields)} columns found)"

    name = fields[0].strip()
    category = fields[1].strip()
    quantity_text = fields[2].strip()
    price_text = fields[3].strip()

    # Check whether the quantity is a whole number
    if not quantity_text.isdigit(): #Checks if it is a digit from 0 to 9 
        if quantity_text.startswith("-") and quantity_text[1:].isdigit(): #Checks if Negative & Checks if the rest of the string is a digit
            return None, f"Negative quantity ({quantity_text})"
        return None, f"Non-numeric quantity ({quantity_text})" 

    # Check whether the price is a valid number 
    if not price_text.replace(".", "", 1).isdigit(): #Checks if price is a number (even if it has a decimal point)
        return None, f"Non-numeric price ({price_text})"

    # Dictionary for the clean row data (Latest Learnt Topic)
    clean_row = {
        "name": name,
        "category": category,
        "quantity": int(quantity_text),
        "price": float(price_text)
    }
    return clean_row, ""

def load_file(filename):
    clean_rows = []
    dirty_rows = []

    try:
        file = open(filename, "r")
    except FileNotFoundError:
        print(f"Error: cannot find {filename}")
        return clean_rows, dirty_rows

    #Skips the header line
    lines = file.read().splitlines()[1:]
    file.close()

     # Check whether the row has 4 fields
    count = []
    rows = []
    for line in lines:
        fields = line.strip().split(",")
        count.append(len(fields))
        rows.append((fields + ["", "", "", ""])[:4])

    names = [row[0].strip() for row in rows]
    categories = [row[1].strip() for row in rows]
    qty = [row[2].strip() for row in rows]
    price = [row[3].strip() for row in rows]

    #Checks the validity of the data and whether its a valid number
    missing = [c < 4 for c in count]
    bad_qty = [not q.isdigit() for q in qty]
    negative_qty = [q.startswith("-") and q[1:].isdigit() for q in qty]
    bad_price = [not p.replace(".", "", 1).isdigit() for p in price]

    valid = []
    for i in range(len(rows)):
        valid.append(not missing[i] and not bad_qty[i] and not bad_price[i])

    # Dictionary for the clean row data (Latest Learnt Topic)
    for i in range(len(rows)):
        if valid[i]:
            clean_row = {
                "name": names[i],
                "category": categories[i],
                "quantity": int(qty[i]),
                "price": float(price[i])
            }
            clean_rows.append(clean_row)
        else:
            if missing[i]:
                reason = f"Missing field ({count[i]} columns found)"
            elif negative_qty[i]:
                reason = f"Negative quantity ({qty[i]})"
            elif bad_qty[i]:
                reason = f"Non-numeric quantity ({qty[i]})"
            else:
                reason = f"Non-numeric price ({price[i]})"

            dirty_row = {"row": i + 1, "product": names[i], "reason": reason}
            dirty_rows.append(dirty_row)

    return clean_rows, dirty_rows

# SHOW LOADING SUMMARY

def show_loading_summary(filename, clean_rows, dirty_rows):

    total_rows = len(clean_rows) + len(dirty_rows)
    print("==========================================")
    print(f" Loading: {filename} ")
    print("==========================================")   
    print(f"Total rows read : {total_rows}")
    print(f"Clean rows      : {len(clean_rows)}")
    print(f"Dirty rows      : {len(dirty_rows)}")
    print()
    print("--- Skipped Rows ---")
    for dirty in dirty_rows:
        print(f"Row {dirty['row']:>2} : {dirty['reason']:<32} - {dirty['product']}")
    print("-" * 60)
    print(f"{len(clean_rows)} rows ready for analysis.")

# >>> TASK 1B Sales Analysis Functions <<<<

def calculate_revenue_by_category(clean_rows):

    revenue_dictionary = {}

    for row in clean_rows:

        category = row['category']
        quantity = row['quantity']
        unit_price = row['price']

        item_revenue = quantity * unit_price

        if category in revenue_dictionary:
            revenue_dictionary[category] += item_revenue

        else:
            revenue_dictionary[category] = item_revenue

    return revenue_dictionary

def calculate_quantity_by_category(clean_rows):

    quantity_dictionary = {}

    for row in clean_rows:

        category = row['category']
        quantity = row['quantity']

        if category in quantity_dictionary:
            quantity_dictionary[category] += quantity

        else:
            quantity_dictionary[category] = quantity

    return quantity_dictionary

def get_best_selling_product(clean_rows):

    product_revenue = {}

    for row in clean_rows:

        product_name = row['name']
        quantity = row['quantity']
        unit_price = row['price']

        item_revenue = quantity * unit_price

        if product_name in product_revenue:
            product_revenue[product_name] += item_revenue

        else:
            product_revenue[product_name] = item_revenue

        best_product = None

        max_revenue = -1.0

        for product_name, revenue in product_revenue.items():

            if revenue > max_revenue:
                max_revenue = revenue
                best_product = product_name

        return best_product, max_revenue

def get_worst_selling_product(clean_rows):
    product_revenue = {}
    for row in clean_rows:
        product_name = row['name']
        quantity = row['quantity']
        unit_price = row['price']
        item_revenue = quantity * unit_price
        
        if product_name in product_revenue:
            product_revenue[product_name] += item_revenue
        else:
            product_revenue[product_name] = item_revenue

    worst_product = None
    min_revenue = float('inf')
    for product_name, revenue in product_revenue.items():
        if revenue < min_revenue:
            min_revenue = revenue
            worst_product = product_name

    return worst_product, min_revenue

# >>> TASK 1C Summary Report <<<<

def sales_report(clean_rows):
    revenue_data = calculate_revenue_by_category(clean_rows)
    quantity_data = calculate_quantity_by_category(clean_rows)
    best_product, best_revenue = get_best_selling_product(clean_rows)
    worst_product, worst_revenue = get_worst_selling_product(clean_rows)

    print("==========================================")
    print("         KEDAI RUNCIT SALES REPORT        ")
    print("==========================================")

    print("==========================================")
    print("            REVENUE BY CATEGORY           ")
    print("==========================================")
    
    total_revenue = 0
    for category in sorted(revenue_data.keys()):
        revenue = revenue_data[category]
        total_revenue += revenue
        print(f"{category:15} : BND {revenue:6.2f}")

    print("==========================================")
    print(f"Total Revenue   : BND {total_revenue:6.2f}")

    print("==========================================")
    print("         QUANTITY SOLD BY CATEGORY        ")
    print("==========================================")

    for category in sorted(quantity_data.keys()):
        quantity = quantity_data[category]
        print(f"{category:15} : {quantity:3} units")

    print("==========================================")
    print("          BEST AND WORST SELLERS          ")
    print("==========================================")

    print(f"Best Seller     : {best_product} (BND {best_revenue:.2f})")
    print(f"Worst Seller    : {worst_product} (BND {worst_revenue:.2f})")
    print("==========================================")

